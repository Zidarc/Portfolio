# Copy to .env.local for local dev (never commit it). On Netlify, set these under
# Site configuration → Environment variables. For Docker, pass them with -e / --env-file.
# How to get them: docs/email-setup.md

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# the Gmail address that authorised the token (messages are sent from it)
GMAIL_SENDER=
# where contact messages should arrive (optional, defaults to GMAIL_SENDER)
CONTACT_TO=

# Sketchpad AI mode (docs/ai-setup.md). Set any of them; they're tried in this order.
# Groq (groq.com, key starts gsk_; not the same as Grok): free tier, fast, about one question a minute.
# GROQ_MODEL is optional (default qwen/qwen3.8-27b; it must read images). GROQ_TEXT_MODELS: optional,
# comma-separated text-only models that also answer typed questions (default openai/gpt-oss-120b,openai/gpt-oss-20b).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TEXT_MODELS=
# xAI (Grok, key starts xai-): paid, answers only once the xAI team has credits. XAI_MODEL is optional (it picks one).
XAI_API_KEY=
XAI_MODEL=
# Google AI Studio key (Gemini, free tier). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local dev only: 1 ignores the AI keys above and answers with practice answers (to try the sketchpad).
AI_PRACTICE=
# Cloudflare Workers AI (the backup): account ID and an API token with "Workers AI" permission.
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Optional: another Workers AI model (default @cf/mistralai/mistral-small-3.1-24b-instruct)
CF_AI_MODEL=
# Optional: any long random string; lets scripts/ask-log.mjs read what visitors asked (GET /api/ask-log)
ASK_LOG_KEY=
