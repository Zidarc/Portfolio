# Copy to .env.local for local dev (never commit it). On Netlify, set these under
# Site configuration → Environment variables. For Docker, pass them with -e / --env-file.
# How to get them: docs/email-setup.md

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# the Gmail address that authorised the token (messages are sent from it)
GMAIL_SENDER=
# where contact messages should arrive (optional, defaults to GMAIL_SENDER)
CONTACT_TO=

# Sketchpad AI mode (docs/ai-setup.md). Set any of them; they're tried in this order.
# xAI (Grok): paid, answers only once the xAI team has credits. XAI_MODEL is optional (it picks one).
XAI_API_KEY=
XAI_MODEL=
# Google AI Studio key (Gemini, free tier). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local dev only: 1 ignores the AI keys above and answers with practice answers (to try the sketchpad).
AI_PRACTICE=
# Cloudflare Workers AI (the backup): account ID and an API token with "Workers AI" permission.
CF_ACCOUNT_ID=
CF_AI_TOKEN=
